{
  "name": "@catalyst-cloud/cli",
  "version": "0.16.19",
  "description": "Set up Catalyst Cloud, check your tickets and manage your account from the command line.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coalesce-labs/catalyst-cloud-skills.git"
  },
  "homepage": "https://github.com/coalesce-labs/catalyst-cloud-skills#readme",
  "bugs": {
    "url": "https://github.com/coalesce-labs/catalyst-cloud-skills/issues"
  },
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "catalyst": "bin/catalyst.js",
    "catalyst-skills": "bin/catalyst-skills.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "vendor"
  ],
  "catalystCloud": {
    "tenantContractRange": "1.x || 2.x",
    "pinnedNode": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version:sync": "node scripts/sync-plugin-version.mjs",
    "skill-lib:sync": "node scripts/sync-skill-lib.mjs",
    "skills:scan": "node scripts/scan-skills.mjs",
    "evals": "node scripts/run-evals.mjs",
    "paths:check": "node scripts/vendor-paths.mjs --check",
    "prose:check": "node scripts/check-public-prose.mjs",
    "settings:check": "node scripts/vendor-settings.mjs --check",
    "self-host:check": "node scripts/vendor-self-host.mjs --check",
    "release:check": "node scripts/release-train-check.mjs && node --test scripts/release-train-check.test.mjs",
    "prepublishOnly": "node scripts/release-train-check.mjs --publish cli"
  },
  "dependencies": {
    "@catalyst-cloud/sdk": "0.16.6",
    "@clack/prompts": "1.8.1",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "@catalyst-cloud/sdk-replica-node": "0.16.6"
  },
  "devDependencies": {
    "@catalyst-cloud/schema": "0.16.5",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
